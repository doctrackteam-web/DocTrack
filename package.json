{
  "name": "doctrack-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "DocTrack Inc. Commercial Enterprise Document Tracking Platform",
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml}\"",
    "check-env": "node scripts/check-env.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^10.8.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.0",
    "turbo": "^2.10.7",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "brace-expansion": "^2.0.1",
    "minimatch": "^9.0.5"
  }
}
