# Application Core
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.doctrack.com

# PostgreSQL / Supabase Connection String
DATABASE_URL=postgresql://doctrack_prod:CHANGE_ME@ep-prod.us-east-1.aws.neon.tech/doctrack?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare R2 Credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=doctrack-prod-documents

# Resend Transactional Email API Key
RESEND_API_KEY=re_123456789
EMAIL_FROM=DocTrack <notifications@doctrack.com>

# Stripe Billing Infrastructure
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_live_123456789
STRIPE_WEBHOOK_SECRET=whsec_123456789
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_123456789
